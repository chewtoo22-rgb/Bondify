<?xml version="1.0" encoding="utf-8"?>
<!-- Shown instead of activity_main.xml when MainActivity detects a cover-screen-width
     window (see CoverScreen.kt). No relay-address/pubkey fields: typing on a 3.4" cover
     screen isn't practical, so this view only surfaces status and a connect/disconnect
     toggle for a relay already configured on the main screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@color/bondify_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/bondify_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_connect"
        android:backgroundTint="@color/bondify_accent" />

</LinearLayout>
