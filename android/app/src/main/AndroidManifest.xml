<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested (not required) so BondifyVpnService can survive Doze/App Standby for the
         phase 5 gate's 30-minute screen-off window; see MainActivity's exemption-request
         flow and ARCHITECTURE.md §9 for why a foreground service alone isn't sufficient on
         every OEM skin. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bondify"
        android:supportsRtl="true">

        <!-- resizeableActivity="true" is what lets One UI's cover-screen continuity (the
             Z Flip line's front display) keep this activity running, resized, when the phone
             is closed, instead of blocking it with an "app isn't optimized" message. It
             defaults to true at this targetSdk already; kept explicit because it's load-
             bearing for MainActivity's compact layout (see CoverScreen.kt) and unverified on
             a real device. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BondifyVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
